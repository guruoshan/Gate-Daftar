# Copy to backend/.env only if you run the server from the backend folder.
# The app's start.sh reads the root .env instead, so this file is optional.

# Development or production
NODE_ENV=development

# The port the API server listens on
PORT=3001

# Public web address used inside approval links (no trailing slash)
PUBLIC_ORIGIN=

# Websites allowed to call the API, comma-separated. Never use *.
ALLOWED_ORIGINS=http://localhost:5173

# Long random phrase used to protect login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Mail server used to send manager approval links. Required in production.
SMTP_URL=

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/database

# Separate database used only by the automated checks
TEST_DATABASE_URL=postgres://user:password@host:5432/database_test

# DB_PATH is no longer used. Records live in PostgreSQL now (see DATABASE_URL).
